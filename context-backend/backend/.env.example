# Application
APP_NAME=ContextAPI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
# Origins allowed to call the API directly (comma-separated). The web app
# uses its /backend proxy instead, which needs no CORS.
CORS_ORIGINS=http://localhost:5173


# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=contextapi
POSTGRES_USERNAME=contextapi
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://contextapi:change-me@localhost:5433/contextapi


# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

REDIS_URL=redis://localhost:6380/0

# Neo4j
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USERNAME=neo4j     
NEO4J_PASSWORD=change-me

NEO4J_URI=bolt://localhost:7687
# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=contextapi
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

RABBITMQ_URL=amqp://contextapi:change-me@localhost:5673/


# Celery
CELERY_BROKER_URL=amqp://contextapi:change-me@localhost:5673/
CELERY_RESULT_BACKEND=redis://localhost:6380/1


# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=contextapi
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false

MINIO_QUARANTINE_BUCKET=contextapi-quarantine
MINIO_DOCUMENT_BUCKET=contextapi-documents
MINIO_PARSED_BUCKET=contextapi-parsed

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_SSL=false


# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310


# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# Email
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=you@example.com
MAIL_FROM_NAME=ContextAPI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false


# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN=60


# Rate Limit
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15



POST_SECURITY_AI_PROVIDER=ollama
POST_SECURITY_AI_BASE_URL=http://localhost:11434
POST_SECURITY_AI_MODEL=qwen3:4b-instruct
POST_SECURITY_AI_TIMEOUT_SECONDS=60


# Ollama: offline LLM generation (Tier B). Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=60
# On a CPU the prompt is read at ~60 tokens/s: a small window keeps answers fast.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TEMPERATURE=0.1
# Keep the model loaded between questions (loading it takes ~20 s on a CPU).
OLLAMA_KEEP_ALIVE=24h
# GPU layers. Leave commented out to let Ollama decide; set 0 for CPU-only
# (needed when the GPU backend returns garbage, e.g. Vulkan on an iGPU).
# OLLAMA_NUM_GPU=0
GENERATION_TIMEOUT_SECONDS=180
# Evidence tokens sent to the model per answer (~15 s per 1000 on a CPU).
GENERATION_CONTEXT_TOKENS=1500
# Second model call when an answer cites too little. Doubles answer time.
GENERATION_REPAIR_ENABLED=false
# Extra model call to refine vague questions before searching.
QUERY_ANALYSIS_LLM_ENABLED=false
# A question asked right after an upload waits this long for indexing to finish.
RETRIEVAL_INDEXING_WAIT_SECONDS=420

# Hugging Face models (BGE-M3, reranker) are loaded from the local cache only.
HF_HUB_OFFLINE=1

# External LLMs (Tier C). Leave empty for a fully offline deployment.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# Docker group id that owns docker.sock (the ingestion worker starts parser
# sandboxes through it). Docker Desktop (Windows/Mac): 0.
# Linux: getent group docker | cut -d: -f3
DOCKER_GID=0
