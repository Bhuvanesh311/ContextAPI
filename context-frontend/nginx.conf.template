server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Uploads go out in batches of up to 10 files of up to 500 MB each.
    client_max_body_size 5200m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Docker's DNS. A variable in proxy_pass makes nginx look the API up again
    # (every 10 s) instead of keeping the address it had at start-up, which
    # goes stale whenever the API container is recreated (502 until restart).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # API: /backend/x -> ${BACKEND_URL}/x
    location /backend/ {
        set $backend_upstream ${BACKEND_URL};
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream big uploads to the API instead of buffering them on disk here.
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    # Hashed build assets never change: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Single-page app: every other path serves index.html (never cached, so
    # a new deploy is picked up on the next load).
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        try_files $uri /index.html;
    }
}
